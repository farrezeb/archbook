{
"layer": "top",
"position": "top",
"height": 30,
"margin-top": 3,
"margin-left": 6,
"margin-right": 6,
"spacing": 0,
"modules-left": [
"custom/apple",
"hyprland/workspaces",
"hyprland/window"
],

"modules-right": [
"bluetooth",
"battery",
"network",
"pulseaudio",
"custom/dunst",
"clock"
],

"custom/apple": {
    "format": "  ",  // ícone Arch (ou  se preferir Mac)
    "tooltip": false
},

"hyprland/workspaces": {
    "format": "{id} {windows}",
    "format-window-separator": " ",
    "window-rewrite-default": "",
    "window-rewrite": {
        "Anki": " ",
        "blueman-manager-wrapped": " ",
        "com.obsproject.Studio": "󰄄 ",
        "com.usebottles.bottles": " ",
        "discord": "󰊴 ",
        "Element": " ",
        "emacs": " ",
        "code": "󰨞",
        "Code": "󰨞",
        "foot": " ",
        "ghidra": " ",
        "Gimp": " ",
        "libreoffice-calc": " ",
        "libreoffice-draw": "󰽉 ",
        "libreoffice-impress": "󰈩 ",
        "libreoffice-writer": "󰷈 ",
        "mpv": " ",
        "mullvad vpn": " ",
        "imv": " ",
        "org.getmonero.": " ",
        "org.kde.kdenlive": " ",
        "signal": "󰭹 ",
        "Slack": "󰒱 ",
        "spotify": " ",
        "teams-for-linux": "󰊻 ",
        "vm2": " ",
        "vm": " ",
        "vlc": "󱍼 ",
        "zathura": " ",
        "qutebrowser": "󰇧 ",
        "zoom": " ",
        "Yazi": "󰇥 ",
        "NVIM": " ",
        "btop": "󰻎 ",
        "htop": "󰻎 ",
        "Steam": " ",
        "btop": "󰻎 ",
        "top": "󰻎 ",
        "virt-manager": " ",
        "virt-viewer": " "
    }
},

"hyprland/window": {
"format": "{}",
"max-length": 60,
"separate-outputs": true
},

"custom/macbook-update": {
    "format": " {}",
    "exec": "~/.local/bin/macbook-update-check",
    "on-click": "~/.local/bin/macbook-update-run",
    "signal": 7,
    "interval": 3600
},

"network": {
"format-wifi": "",
"format-ethernet": "󰈀",
"format-disconnected": "󰤮",
"tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
},

"bluetooth": {
    "format": "",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-connected": "󰂱",
    "format-no-controller": "",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "on-click": "sudo systemctl start bluetooth && blueman-manager"
},

"battery": {
    "bat": "BAT0",
    "interval": 60,
    "states": {
        "warning": 20,
        "critical": 15
    },
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% 󰚥",
    "format-plugged": "{capacity}% ",
    "format-icons": ["","","","",""],
    "tooltip-format": "{timeTo} restantes",
    "events": {
        "on-discharging-warning": "notify-send -u normal '  Bateria baixa' -i battery-low-symbolic -t 10000",
        "on-discharging-critical": "notify-send -u critical '  Bateria CRÍTICA' -i battery-empty-symbolic -t 0"
    }
},

"pulseaudio": {
        "format": "{volume}% {icon}",
        "format-bluetooth": "{volume}% {icon}",
        "scroll-step": 5,
        "format-muted": "0%  ",
        "format-icons": {
            "headphone": " ",
            "hands-free": " ",
            "headset": " ",
            "default": ["", "", ""]
        }
},

"custom/dunst": {
    "exec": "~/.config/waybar/scripts/dunst-history.sh",
    "interval": 5,
    "signal": 1,
    "return-type": "json",
    "format": "{text}",
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/dunst-mark-read.sh",
    "on-click-right": "dunstctl history-clear && rm -f /tmp/dunst-seen-ids && pkill -RTMIN+1 waybar"
},

"clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%d %b %Y}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt>{calendar}</tt>"

}
}
