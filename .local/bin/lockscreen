#!/bin/bash
# Trava de segurança — evita múltiplas instâncias
LOCKFILE="/tmp/lockscreen.lock"
[ -f "$LOCKFILE" ] && exit 0
touch "$LOCKFILE"
trap 'rm -f "$LOCKFILE"' EXIT INT TERM

export HOME="/home/farrezeb"
export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/1000/bus"
export XDG_RUNTIME_DIR="/run/user/1000"

# Detecta WAYLAND_DISPLAY dinamicamente
export WAYLAND_DISPLAY
WAYLAND_DISPLAY=$(ls /run/user/1000/wayland-* 2>/dev/null | head -1 | xargs -r basename)
WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}"

# Carrega cores do Pywal com fallback
# ATENÇÃO: colors.sh exporta as cores COM '#' (ex: color1="#5294e2")
# O swaylock recebe sem '#', por isso usamos ${var#\#} para remover o prefixo
WAL_CACHE="/home/farrezeb/.cache/wal"
if [ -f "${WAL_CACHE}/colors.sh" ]; then
    # shellcheck source=/dev/null
    source "${WAL_CACHE}/colors.sh"
else
    # Fallbacks COM '#' para manter consistência com o Pywal
    color1="#5294e2"
    color2="#a9b7c6"
    foreground="#ffffff"
fi

# Remove o '#' de forma segura (funciona com ou sem '#')
c1="${color1#\#}"
c2="${color2#\#}"
fg="${foreground#\#}"

# Wallpaper com fallback para cor sólida
WALLPAPER=$(cat "${WAL_CACHE}/wal" 2>/dev/null)

if [ -n "$WALLPAPER" ] && [ -f "$WALLPAPER" ]; then
    swaylock -f \
        --image "$WALLPAPER" \
        --clock \
        --indicator \
        --indicator-radius 100 \
        --indicator-thickness 7 \
        --effect-vignette 0.2:0.2 \
        --ring-color "$c1" \
        --key-hl-color "$c2" \
        --text-color "$fg" \
        --inside-color 00000088 \
        --line-color 00000000 \
        --separator-color 00000000 \
        --fade-in 0.1 \
        --datestr "%d/%m/%Y" \
        --timestr "%H:%M"
else
    swaylock -f \
        --color 111111 \
        --clock \
        --indicator \
        --indicator-radius 100 \
        --indicator-thickness 7 \
        --ring-color "$c1" \
        --key-hl-color "$c2" \
        --text-color "$fg" \
        --inside-color 00000088 \
        --line-color 00000000 \
        --separator-color 00000000 \
        --fade-in 0.1 \
        --datestr "%d/%m/%Y" \
        --timestr "%H:%M"
fi
